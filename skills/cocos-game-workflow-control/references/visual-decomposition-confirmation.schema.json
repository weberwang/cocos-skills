{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cocos-visual-decomposition-confirmation.schema.json",
  "title": "效果图原子拆解人工确认记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmation_schema","confirmation_id","status","confirmation_mode","proposal_id","proposal_file","annotation_file","annotation_mime","annotation_width","annotation_height","annotation_schema","annotation_layout","decision_record_file","user_decision_receipt_file","scene_id","state_id","annotation_number","region_id","production_origin","production_method","delivery_kind","production_label","component_ids","state_ids","asset_requirement_ids","asset_ids","user_original_text","accepted_at","work_item_id","candidate_version"],
  "properties": {
    "confirmation_schema": {"const": "visual-decomposition-confirmation/1.0"},
    "confirmation_id": {"type": "string", "minLength": 1},
    "confirmation_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "status": {"const": "accepted"},
    "confirmation_mode": {"const": "manual"},
    "proposal_id": {"type": "string", "minLength": 1},
    "proposal_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "proposal_file": {"type": "string", "minLength": 1},
    "annotation_file": {"type": "string", "pattern": "\\.(?:png)$"},
    "annotation_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "annotation_mime": {"const": "image/png"},
    "annotation_width": {"type": "integer", "minimum": 1},
    "annotation_height": {"type": "integer", "minimum": 1},
    "annotation_schema": {"const": "effect-image-annotation/png/1"},
    "annotation_layout": {"const": "image-plus-right-panel"},
    "annotation_metadata_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "annotation_identity_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "decision_record_file": {"type": "string", "minLength": 1},
    "decision_record_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "user_decision_receipt_file": {"type": "string", "minLength": 1},
    "user_decision_receipt_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "target_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "scene_id": {"type": "string", "minLength": 1},
    "state_id": {"type": "string", "minLength": 1},
    "annotation_number": {"type": "integer", "minimum": 1},
    "region_id": {"type": "string", "minLength": 1},
    "region_definition_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "production_origin": {"type": ["string", "null"]},
    "production_method": {"type": "string", "minLength": 1},
    "delivery_kind": {"type": "string", "minLength": 1},
    "production_label": {"type": "string", "minLength": 1},
    "component_ids": {"$ref": "#/$defs/uniqueStrings"},
    "state_ids": {"$ref": "#/$defs/uniqueStrings"},
    "asset_requirement_ids": {"$ref": "#/$defs/uniqueStrings"},
    "asset_ids": {"$ref": "#/$defs/uniqueStrings"},
    "user_original_text": {"type": "string", "minLength": 1},
    "user_message_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "work_item_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "candidate_sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"}
  },
  "$defs": {
    "sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
    "uniqueStrings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
